# Copy to .env.local and fill in from Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects show an "anon" key instead; either works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: the public address of the site, used in magic-link and Google redirect URLs.
# Leave unset in development (the request's host is used).
# NEXT_PUBLIC_SITE_URL=https://kira.example.com

# AI Inbox: Claude reads uploaded receipts and bills (server only, never sent to the browser).
# ANTHROPIC_API_KEY=sk-ant-...

# Scheduled cron automation (/api/cron/run-due — recurring invoices/bills, depreciation, prepaids).
# CRON_SECRET=replace-with-random-32-byte-secret
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Outbound transactional email via Resend (Team invites, Invoices, Quick invoices, Quotes).
# RESEND_API_KEY=re_...
# RESEND_FROM="Kira <billing@yourdomain.com.my>"

# Live LHDN MyInvois OAuth 2.0 / REST API (optional — falls back to Sandbox simulation when unset).
# MYINVOIS_ENCRYPTION_KEY=replace-with-32-char-secret-for-per-org-client-secrets
# MYINVOIS_CLIENT_ID=your-lhdn-erp-client-id
# MYINVOIS_CLIENT_SECRET=your-lhdn-erp-client-secret
# MYINVOIS_ON_BEHALF_OF=C12345678900
